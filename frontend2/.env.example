# Brauzer API’ga shu manzil orqali murojaat qiladi.
#  /api/v1  — tavsiya: shu sahifa hosti orqali (Vite proxy → BACKEND_URL). Cloudflare Tunnel’da bitta https host yetadi.
#  https://api.domen.uz/api/v1 — backend alohida domenda bo‘lsa (u holda backend .env CORS_ORIGINS ga shu sahifa manzilini qo‘shing)
VITE_API_URL=/api/v1
# Vite proxy maqsadi (FastAPI)
BACKEND_URL=http://127.0.0.1:8000
# Tunnel/domen hostlari (vergul bilan). ".trycloudflare.com" — tezkor tunnelning barcha subdomenlari
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
# HTTPS tunnel orqali hot reload (ixtiyoriy): 443
VITE_HMR_CLIENT_PORT=
