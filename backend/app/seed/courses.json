    "order": 1,
    "title": "Salomlashish",
    "summary": "Здравствуйте, привет va xayrlashish iboralari",
    "status": "published",
    "durationMin": 12,
    "video": {
     "url": "/media/courses/ru-1.mp4",
     "poster": "/media/courses/ru-1.webp"
    },
    "text": "Rus tilida rasmiy va norasmiy salomlashish farqlanadi. Notanish odamga, o‘qituvchiga yoki ish beruvchiga «Здравствуйте» deyiladi. Do‘stlar orasida esa «Привет» ishlatiladi.\n\nXayrlashishda rasmiy «До свидания», norasmiy «Пока» ishlatiladi. Kunning vaqtiga qarab «Доброе утро», «Добрый день», «Добрый вечер» deyish mumkin.",
    "vocab": [
     {
      "word": "Здравствуйте",
      "translation": "Assalomu alaykum (rasmiy)"
     },
     {
      "word": "Привет",
      "translation": "Salom"
     },
     {
      "word": "Доброе утро",
      "translation": "Xayrli tong"
     },
     {
      "word": "Добрый день",
      "translation": "Xayrli kun"
     },
     {
      "word": "Добрый вечер",
      "translation": "Xayrli kech"
     },
     {
      "word": "До свидания",
      "translation": "Xayr (rasmiy)"
     },
     {
      "word": "Пока",
      "translation": "Xayr"
     },
     {
      "word": "Спасибо",
      "translation": "Rahmat"
     }
    ],
    "translations": [
     {
      "source": "Здравствуйте, как дела?",
      "target": "Assalomu alaykum, ishlaringiz qalay?"
     },
     {
      "source": "Привет! Всё хорошо.",
      "target": "Salom! Hammasi yaxshi."
     },
     {
      "source": "Спасибо, до свидания!",
      "target": "Rahmat, xayr!"
