   {
    "id": "ru-2",
    "order": 2,
    "title": "Tanishuv",
    "summary": "Меня зовут…, Я студент…",
    "status": "published",
    "durationMin": 12,
    "video": {
     "url": "/media/courses/ru-2.mp4",
     "poster": "/media/courses/ru-2.webp"
    },
    "text": "O‘zingizni tanishtirish uchun «Меня зовут…» (Mening ismim…) iborasi ishlatiladi. Kasbingiz yoki o‘qishingiz haqida «Я студент» (yigitlar) yoki «Я студентка» (qizlar) deysiz.\n\nSuhbatdoshning ismini so‘rash: rasmiy — «Как вас зовут?», norasmiy — «Как тебя зовут?». Tanishganingizdan xursand ekaningizni «Очень приятно» bilan bildirasiz.",
    "vocab": [
     {
      "word": "Меня зовут…",
      "translation": "Mening ismim…"
     },
     {
      "word": "Как вас зовут?",
      "translation": "Ismingiz nima?"
     },
     {
      "word": "Я студент",
      "translation": "Men talabaman (yigit)"
     },
     {
      "word": "Я студентка",
      "translation": "Men talabaman (qiz)"
     },
     {
      "word": "Очень приятно",
      "translation": "Tanishganimdan xursandman"
     },
     {
      "word": "Я из Ташкента",
      "translation": "Men Toshkentdanman"
     },
     {
      "word": "Мне 19 лет",
      "translation": "Men 19 yoshdaman"
     }
    ],
    "translations": [
     {
      "source": "Меня зовут Азиз, я студент.",
      "target": "Mening ismim Aziz, men talabaman."
     },
     {
      "source": "Как вас зовут?",
      "target": "Ismingiz nima?"
     },
     {
      "source": "Очень приятно!",
      "target": "Tanishganimdan xursandman!"
