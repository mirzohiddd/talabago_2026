# ===== TalabaGo backend sozlamalari — nusxa oling: cp .env.example .env =====
# Haqiqiy .env hech qachon git’ga qo‘shilmaydi (.gitignore).

# --- Telegram ---
BOT_TOKEN=                 # @BotFather bergan token
ADMIN_ID=                  # yangi Support murojaatlari yuboriladigan chat ID (bir nechta: 111,222)
BOT_WEBHOOK_SECRET=        # ixtiyoriy: webhook ishlatilsa tasodifiy satr (python -m app.cli secret)

# --- Xavfsizlik ---
JWT_SECRET_KEY=            # majburiy, kamida 32 belgi: python -m app.cli secret
COOKIE_SECURE=true         # lokal http da false; production (https) da true
USER_TOKEN_DAYS=30
ADMIN_TOKEN_HOURS=8

# --- URL va CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173      # Mini App manzili (bot tugmasi uchun https bo‘lishi shart)
SUPPORT_URL=http://localhost:5174       # TalabaGo Support paneli manzili

# --- Saqlash (persistent disk!) ---
DATA_DIR=data              # JSON va yuklangan media shu papkada; production’da doimiy diskka ulang
BACKUP_KEEP=30
BACKUP_INTERVAL_SECONDS=300

# --- Birinchi administrator (adminlar ro‘yxati bo‘sh bo‘lsa, birinchi ishga tushishda yaratiladi) ---
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=       # python -m app.cli hash-password  (ochiq parol bu yerga yozilmaydi)

# --- Cheklovlar ---
MAX_IMAGE_MB=5
MAX_DOC_MB=5
MAX_VIDEO_MB=60
RATE_LIMIT_ENABLED=true
